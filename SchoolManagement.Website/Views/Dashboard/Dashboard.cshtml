<style>

    .sidebarRight {
        background-color: var(--body-white-color);
        max-width: 270px;
        width: 100%;
        padding-bottom: 0;
        height: calc(100% - 0rem);
        position: fixed;
        padding-top: 0;
        z-index: 9999;
        border-top: none;
        transition: all .2s ease;
        box-shadow: var(--box-shadow);
        right: 0;
        top: 0;
    }

    .siderightcont {
        position: relative;
        height: calc(100% - 0px);
        overflow-y: scroll;
        padding: 20px 10px;
        display: flex;
        flex-direction: column;
        gap: 30px 0px;
    }

    .recent_heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        border-bottom: 1px solid var(--submenu-bg-color );
        padding-bottom: 15px;
    }

        .recent_heading h4 {
            font-size: 16px;
            margin: 0;
        }

        .recent_heading p {
            margin: 5px 0 0;
        }

    .addstudent {
        width: 32px;
        height: 32px;
        background-color: var(--sidebar-bg-color);
        color: var(--body-white-color);
        font-size: 22px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .modal-header h5 {
        font-size: 18px;
        margin: 0;
        font-weight: 600;
    }

    .btnclose {
        font-size: 18px;
        color: var(--logo-bg-color);
    }


    .recent_stud_item1,
    .notice_board_main1 {
        margin-top: 25px;
        max-height: 390px;
        overflow-y: scroll;
    }

        .recent_stud_item1 ul,
        .notice_board_main1 ul {
            display: flex;
            flex-direction: column;
            gap: 10px 0;
        }

    .stud_item_img img {
        border-radius: 100%;
    }

    .recent_stud_item1 ul li {
        display: grid;
        grid-template-columns: 1fr 30px;
        align-items: center;
        gap: 10px;
    }

    .stud_item_main {
        display: grid;
        grid-template-columns: 30px 1fr;
        gap: 10px;
        align-items: center;
    }

    .stud_item_content h6 {
        font-size: 12px;
        margin: 0 0 5px;
    }

    .stud_mail {
        width: 30px;
        height: 30px;
        font-size: 14px;
        background-color: var(--submenu-bg-color);
        border: 2px solid var(--body-text-color);
        border-radius: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .notice_board_main1 ul li {
        background-color: var(--submenu-bg-color);
        padding: 10px;
        border-radius: 10px;
    }

        .notice_board_main1 ul li .notice_date {
            margin-bottom: 5px;
            font-size: 13px;
        }

        .notice_board_main1 ul li p {
            margin-bottom: 5px;
            font-size: 12px;
        }

            .notice_board_main1 ul li p.notice_uesrs {
                margin: 0;
                font-size: 12px;
                color: var(--heading-color);
                display: flex;
                align-items: center;
                justify-content: space-between;
                flex-wrap: nowrap;
            }

    #calendar_dates12 {
        display: flex; /* Makes all dates appear in a row */
        gap: 10px;
        /* Space between dates */
    }

    .event_item {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 10px;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 10px; /* Gap between events */
        color: white;
        font-size: 15px;
        font-weight: normal;
    }

    .week-date {
        padding: 6px 10px;
        margin: 2px;
        display: inline-block;
        cursor: pointer;
        border-radius: 5px;
    }

        .week-date.selected {
            background: #007bff;
            color: white;
            font-weight: bold;
        }

        .week-date.hovered {
            background: #f0f0f0;
            border: 1px solid #007bff;
        }

    .event_time {
        min-width: 60px;
        text-align: left;
        font-weight: bold;
    }

    .event_name {
        font-weight: bold;
        text-align: left;
    }

    .event_bg1 {
        background-color: #f1f0ff;
        color: #A098AE;
    }

    .event_bg2 {
        background-color: #fdf6D8;
        color: #A098AE;
    }

    .event_bg3 {
        background-color: #edf9fd;
        color: #A098AE;
    }
</style>

