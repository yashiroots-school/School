@section scripts{

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script type="text/javascript" src="~/assets/js/custom.js"></script>
    <script src="~/Content/DropDownSelect2/dist/js/select2.min.js"></script>
    <script>
        // Calendar JS
        const calendarDates12 = document.getElementById("calendar_dates12");
        const calendarMonth12 = document.getElementById("calendar_month12");
        const eventList = document.getElementById("event_list");

        let currentDates12 = new Date();
        let currentYear12 = currentDates12.getFullYear();
        let currentMonth12 = currentDates12.getMonth();
        let currentDay12 = currentDates12.getDate();

        function formatDateToYMD(date) {
            let year = date.getFullYear();
            let month = ("0" + (date.getMonth() + 1)).slice(-2);
            let day = ("0" + date.getDate()).slice(-2);
            return `${year}-${month}-${day}`;
        }

        function generateWeekCalendar() {
            calendarDates12.innerHTML = "";
            let currentWeekDay = currentDates12.getDay();
            let weekStart = new Date(currentYear12, currentMonth12, currentDay12 - currentWeekDay);
            calendarMonth12.textContent = `${weekStart.toLocaleString("default", { month: "long" })} ${currentYear12}`;

            for (let i = 0; i < 7; i++) {
                const weekDate = new Date(weekStart);
                weekDate.setDate(weekStart.getDate() + i);

                const dateDiv = document.createElement("div");
                dateDiv.textContent = weekDate.getDate();
                dateDiv.classList.add("week-date");
                dateDiv.dataset.date = formatDateToYMD(weekDate);

                if (weekDate.getDate() === currentDay12 && weekDate.getMonth() === currentMonth12) {
                    dateDiv.classList.add("selected");
                    loadEventsForDate(dateDiv.dataset.date);
                }

                dateDiv.addEventListener("click", function () {
                    document.querySelectorAll(".week-date").forEach(d => d.classList.remove("selected"));
                    this.classList.add("selected");
                    loadEventsForDate(this.dataset.date);
                });

                dateDiv.addEventListener("mouseover", function () { this.classList.add("hovered"); });
                dateDiv.addEventListener("mouseout", function () { this.classList.remove("hovered"); });

                calendarDates12.appendChild(dateDiv);
            }
        }

        function loadEventsForDate(date) {
            fetch(`/Dashboard/GetEventsByDate?date=${date}`)
                .then(res => res.json())
                .then(events => {
                    eventList.innerHTML = "";
                    if (!Array.isArray(events) || events.length === 0) {
                        eventList.innerHTML = "<p>No events for this date.</p>";
                        return;
                    }

                    const bgClasses = ["event_bg1", "event_bg2", "event_bg3"];
                    events.forEach((ev, index) => {
                        const div = document.createElement("div");
                        div.classList.add("event_item", bgClasses[index % bgClasses.length]);
                        div.innerHTML = `
                                            <span class="event_time">${ev.EventTime}</span>
                                            <span>-</span>
                                            <span class="event_name">${ev.EventName}</span>
                                        `;
                        eventList.appendChild(div);
                    });
                })
                .catch(err => {
                    console.error(err);
                    eventList.innerHTML = "<p style='color:red;'>Failed to load events.</p>";
                });
        }

        generateWeekCalendar();
    </script>
    <script>
        $(document).ready(function () {

            //$('.select2').select2();

            // Initialize Teacher DataTable with no default sorting
            var table = $("#TeacherTable").DataTable({
                "order": [], // Disable default sorting
                "columnDefs": [
                    { "searchable": true, "orderable": false } // Disable sorting for the first column (scholar number)
                ]
            });
            GetStudentDetails();
            $("#Class").on('change', function () {
                GetStudentDetails();
            })
            $("#Section").on('change', function () {
                GetStudentDetails();
            })
        });
        function GetStudentDetails() {

            var Class = $("#Class").val();
            var Section = $("#Section").val();
            //dataTable = $('#StudentTable').DataTable({
            var html = "";
            //});
            $.ajax({
                url: '/Dashboard/GetStudentDetails?Class=' + Class + '&Section=' + Section,
                dataType: "json",
                type: "GET",
                success: function (data) {
                    if (data != "Fail" && data != null) {
                        var stdnttbl = document.getElementById('students');
                        html = '';
                        var cnt = 1;
                        html = '<table class="table_main"  id="StudentTable">';
                        html = html + '<thead><tr><th>S.No</th><th>Name</th><th>Id</th><th>Class</th><th>Section</th><th>Attendance</th><th>Profile</th></tr></thead>';
                        html = html + '<tbody id="studentbody">';
                        for (var i = 0; i < data.length; i++) {
                            var Name = data[i].Name + data[i].Last_Name;
                            html += '<td>' + cnt + '</td>';
                            html += '<td>' + Name + '</td>';
                            html += '<td>' + data[i].StudentId + '</td>';
                            html += '<td>' + data[i].Class + '</td>';
                            html += '<td>' + data[i].Section + '</td>';
                            html += '<td>' + data[i].Attendance + '</td>';
                            //  html += '<td><a href="/Student/StudentProfile?applicationNo=""">View Profile</a></td>';
                            html += "<td><a href='/Student/StudentProfile?applicationNo=" + data[i].ApplicationNumber + "' target='_blank'>View Profile</a></td>";

                            html += '</tr>';

                            cnt++;
                        }

                        html += '</tbody></html>'

                        stdnttbl.innerHTML = html;
                        $('#StudentTable').DataTable();
                    }


                },
                error: function (xhr) {
                    window.location.reload();
                }
            });

        }

    </script>
}


