@using System.Data
@using System.Linq
@{
    ViewBag.Title = "WeeklyTimeTable";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/DropDownSelect2/dist/css/select2.min.css" rel="stylesheet" />
<style>
    .table-responsive {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        margin-bottom: 20px;
    }

    table {
        border-collapse: collapse;
        width: 100%;
        table-layout: fixed;
    }

    thead th,
    tbody td {
        padding: 8px;
        border: 1px solid #ddd;
        text-align: left;
        vertical-align: top;
        word-wrap: break-word;
    }

    thead th {
        position: sticky;
        top: 0;
        background-color: #f8f9fa;
        z-index: 3;
    }

    thead th:first-child,
    tbody td:first-child {
        position: sticky;
        left: 0;
        background-color: #f8f9fa;
        z-index: 4;
    }

    .exam-card {
        background: #f1f1f1;
        padding: 5px;
        margin-bottom: 5px;
        border-radius: 4px;
    }

    .exam-card strong {
        display: block;
        font-size: 14px;
    }

    .exam-card div {
        font-size: 13px;
    }

    /* PRINT STYLES */
    @@media print {
        @@page {
            size: A4 landscape;
         
            margin-top:0;
        }

        body * {
            visibility: hidden;
        }

        #printableArea, #printableArea * {
            visibility: visible;
        }

        #printableArea {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }

        .table-responsive {
            overflow: visible !important;
        }

        .btn, .select2, .select2-container {
            display: none !important;
        }

        table {
            table-layout: auto !important;
            font-size: 12px;
        }
    }

    .btn-print {
        margin-bottom: 10px;
    }
</style>

@{
    var dt = ViewBag.DataTable as DataTable;

    var dates = dt.AsEnumerable()
                  .Where(r => r["ExamDate"] != DBNull.Value && !string.IsNullOrEmpty(r["ExamDate"].ToString()))
                  .Select(r => DateTime.ParseExact(r["ExamDate"].ToString().Trim(), "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture))
                  .Distinct()
                  .OrderBy(d => d)
                  .ToList();

    var classes = dt.AsEnumerable()
                    .Where(r => r["ClassName"] != DBNull.Value && !string.IsNullOrEmpty(r["ClassName"].ToString()))
                    .Select(r => r["ClassName"].ToString())
                    .Distinct()
                    .OrderBy(c => c)
                    .ToList();
}

<div class="right_col" role="main">
    <div class="row">
        <h2>Exam Time Table</h2>
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="tab-content tab_sis">
                <div class="tab-pane fade in active" id="add">
                    @using (Html.BeginForm("ExamTimeTable", "Exam", FormMethod.Post))
                    {
                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12">
                                @Html.DropDownList("BatchId", new SelectList(ViewBag.Batch, "Batch_Id", "Batch_Name"), "Select Batch", new { @class = "form-control select2", @required = "required" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12">
                                @Html.DropDownList("TermId", new SelectList(ViewBag.Term, "TermID", "TermName"), "Select Term", new { @class = "form-control select2", @required = "required" })
                            </div>
                            <div class="col-md-2 col-sm-2 col-xs-12">
                                <input type="submit" value="Show" class="btn btn-info" />
                            </div>
                            <div class="col-md-2 col-sm-2 col-xs-12">
                                <button type="button" class="btn btn-success btn-print" onclick="printTable()">Print</button>
                            </div>
                        </div>
                    }
                </div>

                <div class="row" id="printableArea">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    @foreach (var cls in classes)
                                    {
                                        <th>@cls</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var date in dates)
                                {
                                    <tr>
                                        <td>@date.ToString("dd/MM/yyyy")</td>
                                        @foreach (var cls in classes)
                                        {
                                            var exams = dt.AsEnumerable()
                                                          .Where(r =>
                                                              r["ClassName"] != DBNull.Value &&
                                                              r["ExamDate"] != DBNull.Value &&
                                                              r["ClassName"].ToString() == cls &&
                                                              DateTime.ParseExact(r["ExamDate"].ToString().Trim(), "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture) == date
                                                          )
                                                          .ToList();

                                            <td>
                                                @if (exams.Any())
                                                {
                                                    foreach (DataRow exam in exams)
                                                    {
                                                        <div class="exam-card">
                                                            <strong>@exam["Subject_Name"].ToString()</strong>
                                                           
                                                         
                                                            <div>@exam["ExamTime"].ToString()</div>
                                                        </div>
                                                    }
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script src="~/Content/DropDownSelect2/dist/js/select2.min.js"></script>
<script>
    $('.select2').select2();
    function printTable() {
        window.print();
    }
</script>
