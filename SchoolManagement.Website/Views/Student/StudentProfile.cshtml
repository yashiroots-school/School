<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Tab switching functionality
        const tabButtons = document.querySelectorAll('.tab-button');
        const tabSections = document.querySelectorAll('.tab-section');

        tabButtons.forEach(button => {
            button.addEventListener('click', () => {
                const tabId = button.getAttribute('data-tab');

                // Update active tab button
                tabButtons.forEach(btn => btn.classList.remove('active'));
                button.classList.add('active');

                // Show active tab section
                tabSections.forEach(section => section.classList.remove('active'));
                document.getElementById(`${tabId}-details`).classList.add('active');
            });
        });

        // Filter option functionality
        const filterOptions = document.querySelectorAll('.filter-option');

        filterOptions.forEach(option => {
            option.addEventListener('click', () => {
                const parent = option.parentElement;
                const siblings = parent.querySelectorAll('.filter-option');

                siblings.forEach(sib => sib.classList.remove('active'));
                option.classList.add('active');

                // Here you would typically filter the table data
                // For this example, we're just updating the UI state
            });
        });
    });
</script>
<script>
    
        $(document).ready(function() {
            $('.filter-option').click(function () {
                debugger
                $('.filter-option').removeClass('active');
                $(this).addClass('active');
                var id = '@Model.StudentID';
                var batchId = $(this).data('batchid');

                $.ajax({
                    url: '@Url.Action("StudentProfileBatchWise", "Student")',
                    type: 'GET',
                    data: { batchId: batchId, studentId: id },
                    success: function(response) {
                        console.log(response);
                        var tbody = $('#attendanceTable tbody');
                        tbody.empty(); // Clear existing rows

                        if (response.AttendanceSummaries && response.AttendanceSummaries.length > 0) {
                            response.AttendanceSummaries.forEach(function (att) {
                                var row = '<tr>' +
                                    '<td>' + att.BatchName + '</td>' +
                                    '<td>' + att.ClassName + '</td>' +
                                    '<td>' + att.Section + '</td>' +
                                    '<td>' + att.TotalDays + '</td>' +
                                    '<td class="attendance-percent">' + parseFloat(att.AttendancePercentage).toFixed(2) + '%</td>' +
                                    '</tr>';
                                tbody.append(row);
                            });
                        } else {
                            tbody.append('<tr><td colspan="5">No data found for this batch.</td></tr>');
                        }
                        // 2️ Populate Test Percentages Table
                        var testTbody = $('#reportCard tbody');
                        testTbody.empty();

                        if (response.TestPercentages && response.TestPercentages.length > 0) {
                            response.TestPercentages.forEach(function (test) {
                                var row = '<tr>' +
                                    '<td>' + test.BatchName + '</td>' +
                                    '<td>' + test.ClassName + '</td>' +
                                    '<td>' + test.Section + '</td>' +
                                    '<td>' + test.TermName + '</td>' +
                                    '<td>' + test.TotalObtainedMarks + '</td>' +
                                    '</tr>';
                                testTbody.append(row);
                            });
                        } else {
                            testTbody.append('<tr><td colspan="5">No test records found for this batch.</td></tr>');
                        }
                        // 3️⃣ Co-Scholastic Table
                        var coscholasticTbody = $('#coscholastic tbody');
                        coscholasticTbody.empty();

                        if (response.CoScholasticResults && response.CoScholasticResults.length > 0) {
                            response.CoScholasticResults.forEach(function (cos) {
                                // Optional: Calculate average grade if needed (you can implement a mapping from A/B/C to numbers)
                                var avgGrade = cos.CoscholasticGrades; // For now just display the string

                                var row = '<tr>' +
                                    '<td>' + cos.Batch_Name + '</td>' +
                                    '<td>' + cos.ClassName + '</td>' +
                                    '<td>' + cos.SectionName + '</td>' +
                                    '<td>' + cos.TermName + '</td>' +
                                    '<td>' + cos.CoscholasticGrades + '</td>' +
                                    '<td>' + avgGrade + '</td>' +
                                    '</tr>';
                                coscholasticTbody.append(row);
                            });
                        } else {
                            coscholasticTbody.append('<tr><td colspan="6">No co-scholastic records found for this batch.</td></tr>');
                        }
                        // 4️⃣ Fee Details Table
                        var feeTbody = $('#feeDetails tbody');
                        feeTbody.empty();

                        if (response.FeeDetails && response.FeeDetails.length > 0) {
                            response.FeeDetails.forEach(function (fee) {
                                var row = '<tr>' +
                                    '<td>' + fee.PaidAmount + '</td>' +
                                    '<td>' + fee.DueAmount + '</td>' +
                                    '</tr>';
                                feeTbody.append(row);
                            });
                        } else {
                            feeTbody.append('<tr><td colspan="2">No fee records found for this batch.</td></tr>');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error(error);
                    }
                });
            });
        });
</script>
