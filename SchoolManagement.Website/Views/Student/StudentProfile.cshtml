<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Tab switching functionality
        const tabButtons = document.querySelectorAll('.tab-button');
        const tabSections = document.querySelectorAll('.tab-section');

        tabButtons.forEach(button => {
            button.addEventListener('click', () => {
                const tabId = button.getAttribute('data-tab');

                // Update active tab button
                tabButtons.forEach(btn => btn.classList.remove('active'));
                button.classList.add('active');

                // Show active tab section
                tabSections.forEach(section => section.classList.remove('active'));
                document.getElementById(`${tabId}-details`).classList.add('active');
            });
        });

        // Filter option functionality
        const filterOptions = document.querySelectorAll('.filter-option');

        filterOptions.forEach(option => {
            option.addEventListener('click', () => {
                const parent = option.parentElement;
                const siblings = parent.querySelectorAll('.filter-option');

                siblings.forEach(sib => sib.classList.remove('active'));
                option.classList.add('active');

                // Here you would typically filter the table data
                // For this example, we're just updating the UI state
            });
        });
    });
</script>

