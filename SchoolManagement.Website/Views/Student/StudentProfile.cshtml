
@{
    ViewBag.Title = "StudentProfile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
  
        .hello {
            max-width: 1000px;
            margin: 0 auto;
         
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
           
        }

        .profile-header {
            background: linear-gradient(to right, #2563eb, #3b82f6);
            color: white;
            padding: 30px;
            text-align: center;
        }

        .profile-pic {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            border: 5px solid rgba(255, 255, 255, 0.3);
            margin: 0 auto 15px;
            overflow: hidden;
            background-color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .profile-pic i {
            font-size: 60px;
            color: #3b82f6;
        }

        .profile-header h1 {
            font-size: 32px;
            margin-bottom: 5px;
            font-weight: 700;
        }

        .profile-header p {
            font-size: 18px;
            opacity: 0.9;
        }

        .tabs {
            display: flex;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
        }

        .tab-button {
            flex: 1;
            padding: 18px;
            text-align: center;
            background: none;
            border: none;
            font-size: 16px;
            font-weight: 600;
            color: #64748b;
            cursor: pointer;
            transition: all 0.3s;
        }

        .tab-button.active {
            color: #2563eb;
            border-bottom: 3px solid #2563eb;
            background: rgba(37, 99, 235, 0.05);
        }

        .tab-button:hover {
            background: rgba(37, 99, 235, 0.08);
        }

        .tab-content {
            padding: 30px;
        }

        .tab-section {
            display: none;
        }

        .tab-section.active {
            display: block;
        }

        .section-title {
            font-size: 22px;
            color: #2563eb;
            margin-bottom: 25px;
            padding-bottom: 12px;
            border-bottom: 2px solid #e2e8f0;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 25px;
        }

        .info-card {
            background: #f8fafc;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        .info-card h3 {
            font-size: 18px;
            color: #334155;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 1px solid #e2e8f0;
        }

        .info-item {
            margin-bottom: 12px;
            display: flex;
        }

        .info-label {
            font-weight: 600;
            color: #475569;
            min-width: 140px;
        }

        .info-value {
            color: #64748b;
        }

        .filter-options {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .filter-option {
            padding: 8px 16px;
            border-radius: 20px;
            background: #f1f5f9;
            border: 1px solid #cbd5e1;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .filter-option.active {
            background: #2563eb;
            color: white;
            border-color: #2563eb;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th, td {
            padding: 14px 16px;
            text-align: left;
            border-bottom: 1px solid #e2e8f0;
        }

        th {
            background-color: #f1f5f9;
            color: #2563eb;
            font-weight: 600;
        }

        tr:hover {
            background-color: #f8fafc;
        }

        .attendance-percent {
            font-weight: 600;
            color: #16a34a;
        }

        .marks-total {
            font-weight: 600;
            color: #2563eb;
        }

        @@media (max-width: 768px) {
            .profile-header {
                padding: 20px;
            }

            .profile-pic {
                width: 120px;
                height: 120px;
            }

            .profile-header h1 {
                font-size: 26px;
            }

            .tab-button {
                padding: 14px 8px;
                font-size: 14px;
            }

            .tab-content {
                padding: 20px;
            }

            .info-grid {
                grid-template-columns: 1fr;
            }

            th, td {
                padding: 10px;
                font-size: 14px;
            }
        }

        @@media (max-width: 480px) {
            .tabs {
                flex-direction: column;
            }

            .tab-button {
                text-align: left;
                padding: 14px 20px;
                border-bottom: 1px solid #e2e8f0;
            }

            .tab-button.active {
                border-bottom: 3px solid #2563eb;
                border-left: 3px solid #2563eb;
                border-right: none;
            }

            table {
                display: block;
                overflow-x: auto;
            }

            .info-item {
                flex-direction: column;
            }

            .info-label {
                min-width: auto;
                margin-bottom: 4px;
            }
        }
</style>
