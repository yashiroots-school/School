            /* Page-break avoid */
            .sheet, .page, .school, .footer, .body-grid, .left-section {
                break-inside: avoid !important;
                page-break-inside: avoid !important;
            }

            /* Print pe button hide */
            .no-print {
                display: none !important;
            }
        }
        /* ===================== END PRINT ONLY ===================== */

